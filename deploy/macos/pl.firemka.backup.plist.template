<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>pl.firemka.backup</string>
    <key>ProgramArguments</key>
    <array>
        <string>__FIREMKA_CLIENT_PATH__</string>
        <string>run</string>
        <string>--config</string>
        <string>__FIREMKA_CONFIG_PATH__</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>3600</integer>
    <key>ProcessType</key>
    <string>Background</string>
    <key>StandardOutPath</key>
    <string>__FIREMKA_LOG_PATH__</string>
    <key>StandardErrorPath</key>
    <string>__FIREMKA_ERROR_LOG_PATH__</string>
</dict>
</plist>
