# Copy this file to .env and replace every value marked CHANGE_ME.
# Do not commit the copied .env file.
POSTGRES_DB=firemka
POSTGRES_USER=firemka
POSTGRES_PASSWORD=CHANGE_ME_use_a_long_random_password

# Public HTTPS address served by Caddy, for example: ksiegowosc.example.pl
FIREMKA_DOMAIN=CHANGE_ME_example.com
CADDY_EMAIL=CHANGE_ME_admin@example.com

# Local defaults. On a VPS replace :local with one unique release tag per build,
# keep the previous tags, and record the resulting image IDs before switching.
FIREMKA_WEB_IMAGE=firemka-web:local
FIREMKA_WORKER_IMAGE=firemka-worker:local
FIREMKA_CADDY_IMAGE=firemka-caddy:local
FIREMKA_POSTGRES_IMAGE=firemka-postgres:local

# KSeF incoming is off until test access is supplied outside Git.
KSEF_INCOMING_ENABLED=false
KSEF_ENVIRONMENT=Test
KSEF_ALLOW_PRODUCTION=false
KSEF_ACCESS_TOKEN=

# KSeF outgoing stays off until the test adapter is accepted separately.
KSEF_OUTGOING_ENABLED=false
KSEF_OUTGOING_ALLOW_PRODUCTION=false
KSEF_OUTGOING_ALLOW_AUTOMATION=false

# E-mail stays off until a test inbox and SMTP credentials are supplied outside Git.
EMAIL_ENABLED=false
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_ENABLE_SSL=true
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_RECIPIENT=pawel@sitback.pl
