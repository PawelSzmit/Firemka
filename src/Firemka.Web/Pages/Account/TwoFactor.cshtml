@page
@model Firemka.Web.Pages.Account.TwoFactorModel
@{
    ViewData["Title"] = "Potwierdzenie logowania";
}

<div class="auth-card">
    <h1>Potwierdź logowanie</h1>
    <p>Wpisz sześciocyfrowy kod z aplikacji uwierzytelniającej. Jeśli nie masz do niej dostępu, wybierz kod odzyskiwania.</p>

    <form method="post">
        <input type="hidden" asp-for="ReturnUrl" />
        <firemka-validation-summary summary="ModelOnly" class="text-danger" role="alert" />
        <div class="mb-3">
            <label asp-for="Input.Code" class="form-label"></label>
            <input asp-for="Input.Code" class="form-control" autocomplete="one-time-code" inputmode="numeric" />
            <span asp-validation-for="Input.Code" class="text-danger"></span>
        </div>
        <div class="form-check mb-3">
            <input asp-for="Input.UseRecoveryCode" class="form-check-input" />
            <label asp-for="Input.UseRecoveryCode" class="form-check-label">To jest kod odzyskiwania</label>
        </div>
        <div class="form-check mb-3">
            <input asp-for="Input.TrustThisDevice" class="form-check-input" />
            <label asp-for="Input.TrustThisDevice" class="form-check-label">Zaufaj temu urządzeniu przez 30 dni</label>
        </div>
        <button type="submit" class="btn btn-primary">Zaloguj</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
