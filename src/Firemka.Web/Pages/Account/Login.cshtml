@page
@model Firemka.Web.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Logowanie";
}

<div class="auth-card">
    <h1>Logowanie do Firemki</h1>
    <p>Podaj e-mail i hasło. Następnie potwierdzisz logowanie kodem z aplikacji uwierzytelniającej, chyba że rozpoznajemy zaufane urządzenie.</p>

    <form method="post">
        <input type="hidden" asp-for="ReturnUrl" />
        <firemka-validation-summary summary="ModelOnly" class="text-danger" role="alert" />
        <div class="mb-3">
            <label asp-for="Input.Email" class="form-label"></label>
            <input asp-for="Input.Email" class="form-control" autocomplete="username" />
            <span asp-validation-for="Input.Email" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Input.Password" class="form-label"></label>
            <input asp-for="Input.Password" class="form-control" autocomplete="current-password" />
            <span asp-validation-for="Input.Password" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary">Dalej</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
