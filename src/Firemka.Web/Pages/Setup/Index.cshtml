@page
@model Firemka.Web.Pages.Setup.IndexModel
@{
    ViewData["Title"] = "Pierwsza konfiguracja";
}

<div class="auth-card">
    <h1>Utwórz konto właściciela</h1>
    <p>To jednorazowa konfiguracja Firemki. Po zapisaniu ustawisz aplikację uwierzytelniającą z kodami TOTP.</p>

    <form method="post">
        <firemka-validation-summary summary="ModelOnly" class="text-danger" role="alert" />
        <div class="mb-3">
            <label asp-for="Input.Email" class="form-label"></label>
            <input asp-for="Input.Email" class="form-control" autocomplete="username" />
            <span asp-validation-for="Input.Email" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Input.Password" class="form-label"></label>
            <input asp-for="Input.Password" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="Input.Password" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Input.ConfirmPassword" class="form-label"></label>
            <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary">Utwórz konto i ustaw TOTP</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
